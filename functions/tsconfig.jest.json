{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest"],
    "outDir": "dist-tests",
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
